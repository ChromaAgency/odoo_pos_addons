<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit POS Payment Form View -->
    <record id="pos_payment_form_view_inherit" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="after">
                <field name="lot"/>
                <field name="coupon"/>
                <field name="terminal"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit POS Payment Tree/List View -->
    <record id="pos_payment_tree_view_inherit" model="ir.ui.view">
        <field name="name">pos.payment.tree.inherit</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="after">
                <field name="lot"/>
                <field name="coupon"/>
                <field name="terminal"/>
            </xpath>
        </field>
    </record>
</odoo>
