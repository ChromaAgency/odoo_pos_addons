<?xml version="1.0" encoding="UTF-8"?>

<templates id="datetime_widget" inherit_id="point_of_sale.template" xml:space="preserve">

	
	<t t-name="DatetimeSelectWidget" owl="1">
		<div role="dialog" class="modal-dialog">
			<div class="popup" style="height: 550px !important;">
				<p class="title">
					<t t-esc="props.title" />
				</p>
				<section>
					<div class="body">
						<div class="form-group" style="position:relative;display:inline;">
							<label class="control-label">Hora de entrega</label>
							<div class='input-group date' id='del_date'>
								<input type='text' class="form-control " />
								<span class="input-group-addon">
									<span class="fa fa-calendar"></span>
								</span>
							</div>
						</div>
						<div class="footer">
							<div class="button cancel" t-on-click="cancel">
								<t t-esc="props.cancelText" />
							</div>
							<div class="button select" t-on-click="select">
								<t t-esc="props.confirmText" />
							</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</t>
	
</templates>