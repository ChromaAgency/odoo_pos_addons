<?xml version="1.0" encoding="utf-8"?>
<templates id="delivery_order_list_tile" inherit_id="point_of_sale.template" xml:space="preserve">
	<t t-name="DeliveryOrderListTile" owl="1">
		<tr class='order-line'>
                                                    
			<td>
				<t t-esc="date" />
			</td>
			<td>
				<t t-esc="name" />
			</td>
			<td>
				<t t-esc="address" />
			</td>
			<td>
				<t t-esc="phone" />
			</td>
			<td>
				<t t-esc="amount_total" />
			</td>
			<td>
				<t t-esc="amount_return" />
			</td>
			<td>
				<t t-esc="total_cash_to_return" />
			</td>
			<td t-if="delivery_date">
				<td style="display: flex; flex-direction: column; width: max-content;">
					<t t-if="order.delivery_state == 'draft'">
						<button style="box-shadow: 0px 1px 3px rgb(0 0 0 / 40%); background: #7cfc00;"
								t-on-click="setInProgress()">En camino</button>

					</t>
					<t t-if="order.delivery_state == 'in_progress'">
						<button style="box-shadow: 0px 1px 3px rgb(0 0 0 / 40%); background: #00c0ff;"
								t-on-click="setPayed()">Finalizar</button>
					</t>
					<t t-if="order.delivery_state == 'draft' or order.delivery_state == 'in_progress' or order.delivery_state == 'delivered'">
						<button style="box-shadow: 0px 1px 3px rgb(0 0 0 / 40%); background: #ff000066;"
								t-on-click="setCancel('click-cancel', order)">Cancelar</button>
					</t>
				</td>
			</td>
			<td t-else="">
				<HomeDelivery order="order"/>
			</td>
			</tr>
	</t>
</templates>