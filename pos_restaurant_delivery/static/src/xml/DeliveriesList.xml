<?xml version="1.0" encoding="UTF-8" ?>
<templates id="pos_delivery_employee_template" inherit_id="point_of_sale.template" xml:space="preserve">

    <t t-name="ShowEmployeeButton" owl="1">
		<div class="control-button">
			<i class="fa fa-user" />
            <span> </span>
            <span>Deliveries por persona</span>
		</div>
	</t>

    <t t-name="DeliveriesList" owl="1">
        <div class="clientlist-screen screen">
            <div class="screen-content">
                <div class="top-content">
                    <div class='button back' t-on-click="cancel">
                        <i class='fa fa-angle-double-left'></i>
                        Cancelar
                    </div>
                </div>
                <section class="full-content">
                    <div class="client-window">
                        <section class="subwindow list">
                            <div class="subwindow-container">
                                <div class="subwindow-container-fix scrollable-y" style="overflow-x: auto !important;">
                                    <table class='client-list'>
                                        <thead>
                                            <tr>
                                                <th>Delivery</th>
                                                <th>Ordenes totales</th>
                                                <th></th>
                                                <th>Monto Total</th>
                                                <th>Cambio total</th>
                                                <th>Cambio + total</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody class='show-order-list-lines'>
                                            <t t-foreach="allemployees" t-as="emp" t-key="emp.id">
                                                <DeliveryListTile employee="emp" />>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </section>
                    </div>
                </section>
            </div>
        </div>
    </t>

    <t t-name="DeliveriesOrderList" owl="1">
        <div class="clientlist-screen screen container">
            <div class="screen-content">
                <section class="top-content">
                    <div class='button back' t-on-click="cancel">
                        <i class='fa fa-angle-double-left'></i>
                        Cancelar
                    </div>
                </section>
                <section class="full-content">
                    <div class='window'>
                        <section class='subwindow'>
                            <div class='subwindow-container'>
                                <div class='subwindow-container-fix touch-scrollable scrollable-y' style="overflow-x: auto !important;">
                                    <table class='client-list'>
                                        <thead>
                                            <tr>
                                                <th>Order No.</th>
                                                <th>Hora</th>
                                                <th>Cliente</th>
                                                <th>Delivery</th>
                                                <th>Monto total</th>
                                                <th>Cambio</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody class='show-order-list-lines'>
                                            <t t-foreach="allorders" t-as="order" t-key="order.id">
                                                <DeliveryOrderListTile order="order"/>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </section>
                    </div>
                </section>
            </div>
        </div>
    </t>

</templates>